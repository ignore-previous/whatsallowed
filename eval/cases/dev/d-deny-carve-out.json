{
  "id": "d-deny-carve-out",
  "split": "dev",
  "risky": [
    "DENY"
  ],
  "rationale": "Read(!.env.local) carves .env.local out of Read(.env*) (DENY rule).",
  "source": "synthetic",
  "files": {
    "./.claude/settings.json": {
      "permissions": {
        "deny": [
          "Read(.env*)",
          "Read(!.env.local)"
        ]
      }
    },
    "./.env.local": "A=1\n"
  }
}
